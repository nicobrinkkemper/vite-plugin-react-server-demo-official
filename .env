# Not secrets: a Vite env-forwarding shim. Vite interpolates $VAR from the
# process environment at build time, so plain BASE_URL/PUBLIC_ORIGIN/
# GITHUB_PAGES set by a build command (CI, Cloudflare Workers Builds) become
# import.meta.env.VITE_* defines without each command restating the VITE_
# prefix. Tracked on purpose; builds break without it.
VITE_BASE_URL=$BASE_URL
VITE_PUBLIC_ORIGIN=$PUBLIC_ORIGIN
VITE_GITHUB_PAGES=$GITHUB_PAGES
